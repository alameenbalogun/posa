{
  "expo": {
    "name": "POSA",
    "slug": "posa",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "posa",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "POSA uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "POSA uses biometrics to unlock the terminal."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.posa.terminal",
      "requireFullScreen": false
    },
    "android": {
      "package": "app.posa.terminal",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "POSA — Point of Sale & Retail Operations"
    },
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
